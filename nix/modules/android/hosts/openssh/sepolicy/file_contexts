# File contexts for the robotnix OpenSSH server.
# Appended to system/sepolicy/private/file_contexts by ../default.nix.

# The init launcher: labelling it sshd_exec is what drives the init -> sshd
# domain transition (see sshd.te / init_daemon_domain).
/system/bin/ssh_start                       u:object_r:sshd_exec:s0

# The daemon and the helpers it re-execs (sshd-session, sshd-auth, sftp-server).
/system/opt/openssh/sbin/sshd               u:object_r:sshd_exec:s0
/system/opt/openssh/libexec(/.*)?           u:object_r:sshd_exec:s0
# ssh-keygen is run by the launcher to generate host keys on first boot.
/system/opt/openssh/bin/ssh-keygen          u:object_r:sshd_exec:s0

# Mutable runtime state.
/data/ssh(/.*)?                             u:object_r:ssh_data_file:s0
