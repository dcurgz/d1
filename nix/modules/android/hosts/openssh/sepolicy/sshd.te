# SELinux policy for the robotnix OpenSSH server.
#
# Defines a `sshd` coredomain daemon, started by init from sshd.rc, that runs
# the statically-linked OpenSSH binaries under /system/opt/openssh. This is the
# enforcing-mode equivalent of the unconstrained domain Magisk would run sshd in.
#
# Installed into system/sepolicy/private by ../default.nix. It follows AOSP
# conventions; GrapheneOS hardens the base policy further, so the exact allow
# set may need tightening/adjustment when validated on a real device build.

type sshd, domain, coredomain;
type sshd_exec, exec_type, file_type, system_file_type;

# Runtime state under /data/ssh (host keys, authorized_keys, pid file).
type ssh_data_file, file_type, data_file_type, core_data_file_type;

# Port label for the sshd listen port (8022). Added to port_contexts by
# ../default.nix so the kernel can label the socket before name_bind is checked.
type sshd_port_t, port_type;

# init execs the labelled launcher (/system/bin/ssh_start) and transitions here.
init_daemon_domain(sshd)

#
# Networking: bind the configured port (8022) and service TCP connections.
#
net_domain(sshd)
allow sshd self:tcp_socket { create_stream_socket_perms listen accept };
allow sshd sshd_port_t:tcp_socket name_bind;

#
# Capabilities sshd needs to drop privileges, chroot the privsep child, and
# (optionally) bind a low port.
#
allow sshd self:capability {
    setuid
    setgid
    setpcap
    sys_chroot
    net_bind_service
    chown
    fowner
    fsetid
    kill
    dac_override
    dac_read_search
};

#
# Run the privilege-separation helpers (sshd-session, sshd-auth), the OpenSSH
# tools (ssh-keygen) and a login shell for interactive sessions.
#
allow sshd sshd_exec:file { rx_file_perms execute_no_trans };
allow sshd shell_exec:file rx_file_perms;
# ssh_start is a shell script; allow it to run toybox et al. from /system/bin.
allow sshd system_file:file execute_no_trans;
allow sshd system_file:dir { search read open getattr };
allow sshd system_file:lnk_file { read getattr };

#
# Pseudo-terminals for interactive sessions.
#
create_pty(sshd)

#
# Read its config + host keys, manage /data/ssh.
#
allow sshd ssh_data_file:dir create_dir_perms;
allow sshd ssh_data_file:file create_file_perms;
allow sshd ssh_data_file:lnk_file { create read getattr unlink };

#
# Misc essentials most network daemons need.
#
allow sshd self:process { setexec setrlimit setsched };
allow sshd self:fifo_file rw_file_perms;
allow sshd self:unix_stream_socket { create_stream_socket_perms connectto };
allow sshd self:netlink_route_socket nlmsg_read;
allow sshd self:udp_socket create_socket_perms;

# Resolve user/group info and read system properties.
allow sshd proc_net:file r_file_perms;

# Write a startup log to /data/local/tmp/sshd.log (shell_data_file) so it
# is readable by the adb shell user for post-mortem diagnosis without root.
allow sshd shell_data_file:dir { search write add_name };
allow sshd shell_data_file:file { create write open getattr };
