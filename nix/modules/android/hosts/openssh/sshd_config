# sshd_config for the robotnix OpenSSH server.
#
# Ported from the MagiskSSH module, modernised for OpenSSH 10.x:
#   - password / keyboard-interactive auth is disabled (pubkey only)
#   - the deprecated `UsePrivilegeSeparation` directive has been removed
#     (it no longer exists and would make sshd refuse to start)
#
# Runtime state (host keys, per-user authorized_keys) lives under /data/ssh,
# exactly like the Magisk module. A read-only copy of this file is baked into
# the system image; if /data/ssh/sshd_config exists it takes precedence (the
# init script points sshd at it when present).

# Listen on a high port so we do not need the CAP_NET_BIND_SERVICE-style
# SELinux/init privileges required to bind 22.
Port 8022
AddressFamily any

HostKey /data/ssh/ssh_host_ed25519_key
HostKey /data/ssh/ssh_host_rsa_key
HostKey /data/ssh/ssh_host_ecdsa_key

PidFile /data/ssh/sshd.pid

# Pubkey-only. No passwords are provisioned on the device.
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password

# Look for keys baked into the image first, then in the per-user data dir.
AuthorizedKeysFile /system/opt/openssh/etc/authorized_keys.d/%u /data/ssh/%u/.ssh/authorized_keys

X11Forwarding no
PrintMotd no
PrintLastLog no
UseDNS no

# Provide sftp without an external sftp-server binary.
Subsystem sftp internal-sftp

AcceptEnv LANG LC_*
