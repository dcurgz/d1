#!/usr/bin/env bash
set -euo pipefail

USER_PWD="$(pwd)"
SANDBOX_HOME="$HOME/.claude-sandbox"
mkdir -p "$SANDBOX_HOME"

exec bwrap \
  --ro-bind /etc /etc \
  --ro-bind /nix /nix \
  --ro-bind /run /run \
  --ro-bind /usr /usr \
  --proc /proc \
  --dev /dev \
  --symlink /usr/lib64 /lib64 \
  --tmpfs /tmp \
  --unshare-all \
  --share-net \
  --die-with-parent \
  --new-session \
  --cap-drop ALL \
  --bind "$USER_PWD" /workspace \
  --bind "$SANDBOX_HOME" "$SANDBOX_HOME" \
  --setenv HOME "$SANDBOX_HOME" \
  --setenv IS_SANDBOX 1 \
  --chdir /workspace \
  claude --dangerously-skip-permissions "$@"
